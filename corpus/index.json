{
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "name": "The Front Desk Review — full pricing & product-facts corpus",
  "description": "An independent, sourced, dated transparency corpus of published pricing and buyer-critical product facts across 133 software, SaaS and subscription categories (1054 vendors, 3661 plan records). Every figure is traced to its primary source URL and the date it was captured; quote-only tiers carry a null price, never a guess.",
  "publisher": {
    "@type": "Organization",
    "name": "The Front Desk Review",
    "url": "https://frontdeskreview.com"
  },
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://frontdeskreview.com/data/",
  "dateModified": "2026-06-14",
  "measurementTechnique": "Per-record provenance: each price/fact carries source.url + accessedAt; a second corroborating source where available; quote-only/enterprise tiers recorded as null rather than estimated.",
  "distribution": [
    {
      "@type": "DataDownload",
      "name": "all-plans.csv",
      "encodingFormat": "text/csv",
      "contentUrl": "all-plans.csv"
    },
    {
      "@type": "DataDownload",
      "name": "all-plans.jsonl",
      "encodingFormat": "application/x-ndjson",
      "contentUrl": "all-plans.jsonl"
    },
    {
      "@type": "DataDownload",
      "name": "vendors.jsonl",
      "encodingFormat": "application/x-ndjson",
      "contentUrl": "vendors.jsonl"
    }
  ],
  "variableMeasured": [
    "theme",
    "kind",
    "vendor_slug",
    "vendor_name",
    "domain",
    "plan_name",
    "monthly_usd",
    "annual_discount_pct",
    "billing_model",
    "setup_fee_usd",
    "minutes_included",
    "calls_included",
    "overage_per_min",
    "overage_per_call",
    "hipaa",
    "baa",
    "soc2",
    "gdpr",
    "free_tier",
    "free_trial_days",
    "key_features",
    "best_for",
    "integrations",
    "source_url",
    "accessed_at",
    "corroboration_url"
  ],
  "themeCount": 133,
  "totalVendors": 1054,
  "totalPlans": 3661,
